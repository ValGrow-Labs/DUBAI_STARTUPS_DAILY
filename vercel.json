{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-news.xml",
      "destination": "/api/render?path=/sitemap-news.xml"
    },
    {
      "source": "/((?!api/|assets/|uploads/|favicon\\.svg|og-default\\.png|logo\\.png|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/api/render?path=/$1"
    }
  ]
}
